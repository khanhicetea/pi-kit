{
  "name": "@khanhicetea/pi-wui",
  "version": "0.1.5",
  "description": "A session-scoped Web UI portal for Pi and MCP-compatible coding agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanhicetea/pi-wui.git"
  },
  "homepage": "https://github.com/khanhicetea/pi-wui#readme",
  "bugs": {
    "url": "https://github.com/khanhicetea/pi-wui/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "coding-agent",
    "mcp",
    "generative-ui",
    "json-render"
  ],
  "bin": {
    "pi-wui-mcp": "./dist/mcp.js"
  },
  "files": [
    "src",
    "skills",
    ".codex-plugin",
    ".mcp.json",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "npm run build:web && npm run build:mcp",
    "build:web": "vite build",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "quality": "biome check . --error-on-warnings",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/web/**' --test-coverage-lines=80 --test-coverage-branches=60 --test-coverage-functions=65 test/*.test.ts",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/check-release-hygiene.mjs",
    "check": "npm run quality && npm run release:check && npm run typecheck && npm test && npm run build",
    "setup-hooks": "node scripts/setup-git-hooks.mjs",
    "prepare": "npm run setup-hooks",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@json-render/shadcn": "^0.19.0",
    "react": "^19.2.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
