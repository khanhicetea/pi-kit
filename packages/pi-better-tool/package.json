{
	"name": "@khanhicetea/pi-better-tool",
	"version": "0.2.4",
	"description": "Context-aware tools for pi: safe edits, syntax-aware symbol reads, and raw source import-zone reads",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/khanhicetea/pi-kit.git",
		"directory": "packages/pi-better-tool"
	},
	"homepage": "https://github.com/khanhicetea/pi-kit/tree/main/packages/pi-better-tool",
	"bugs": {
		"url": "https://github.com/khanhicetea/pi-kit/issues"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"edit",
		"read",
		"symbols",
		"imports",
		"tree-sitter",
		"tools"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "npm run typecheck && npm test",
		"prepublishOnly": "npm run check"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@types/node": "^24.0.0",
		"typebox": "^1.0.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@ast-grep/lang-bash": "0.0.8",
		"@ast-grep/lang-c": "0.0.6",
		"@ast-grep/lang-cpp": "0.0.6",
		"@ast-grep/lang-csharp": "0.0.6",
		"@ast-grep/lang-go": "0.0.6",
		"@ast-grep/lang-java": "0.0.7",
		"@ast-grep/lang-kotlin": "0.0.7",
		"@ast-grep/lang-php": "0.0.7",
		"@ast-grep/lang-python": "0.0.6",
		"@ast-grep/lang-ruby": "0.0.7",
		"@ast-grep/lang-rust": "0.0.7",
		"@ast-grep/lang-swift": "0.0.8",
		"@ast-grep/napi": "0.45.3"
	}
}
