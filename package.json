{
  "name": "pi-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A monorepo of Pi extensions",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-multi-codex/index.ts",
      "./packages/pi-dede/src/index.ts",
      "./packages/pi-wui/src/index.ts",
      "./packages/pi-better-tool/src/index.ts",
      "./packages/web-access-kit/extensions/web-access-kit.ts"
    ],
    "skills": [
      "./packages/pi-dede/skills",
      "./packages/pi-wui/skills",
      "./packages/web-access-kit/skills"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "quality": "npm run quality --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
